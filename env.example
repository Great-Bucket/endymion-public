# Endymion — environment variables template
# Copy to .env and adjust for your setup.
# Neither .env nor any local override file should ever be committed to git.

# --- Sensor ---
# Which sensor backend to use:
#   mock      — simulated sine-wave signal, no hardware needed (Pi testing)
#   camera    — webcam via OpenCV frame differencing (iMac / USB webcam)
#   picamera  — Pi Camera Module NoIR via picamera2 (Pi CSI port)
#   kinect    — Kinect v1 depth sensor via libfreenect
#   leap      — Leap Motion (stub, not yet implemented)
SENSOR_TYPE=camera

# Camera device index (0 = default webcam). Used by camera sensor only.
CAMERA_INDEX=0

# --- Kinect sensor (SENSOR_TYPE=kinect) ---
# Kinect device index (0 = first connected Kinect).
KINECT_DEVICE_INDEX=0
# Depth range (mm) that counts as "viewer zone". Pixels outside this range
# are excluded from the foreground mask. Tune for your space.
# 500mm = 0.5m minimum (avoids sensor noise), 3500mm = 3.5m maximum.
KINECT_MIN_DEPTH=500
KINECT_MAX_DEPTH=3500
# Frames averaged to build the background model on startup (~1s at 30fps).
# Press B at runtime to recalibrate. Cave must be empty during capture.
KINECT_BG_FRAMES=30
# Depth difference (mm) at which a pixel counts as foreground vs. the
# empty-cave background. Higher = ignore small protrusions / sensor jitter.
KINECT_FG_DEPTH_THRESHOLD_MM=200.0
# Minimum foreground pixel count to treat the cave as occupied. Below
# this, raw=1.0 (cave reads as empty). Higher = ignore noise blobs.
KINECT_MIN_FG_PIXELS=20000
# Number of pixels in the foreground mask that must flip state between
# frames to count as fully moving. Higher = more forgiving (breathing
# / micro-shifts don't trigger); lower = stricter stillness required.
KINECT_MASK_CHANGE_THRESHOLD=40000
# When 1 (default): empty cave returns raw=0.0 → video plays dark when no one
# is present (correct ambient state between visitors). The penalty fires
# continuously while the cave is empty; viewers earn brightness by sitting still.
# When 0: legacy behaviour — empty cave returns raw=1.0 → bright.
# See docs/SPEC-empty-cave-dark.md.
EMPTY_CAVE_DARK=1
# KINECT_ROI_FRACTION is no longer used by the kinect sensor — kept only
# for backwards compatibility with old .env files. Safe to remove.

# MockSensor: seconds per full oscillation cycle (still → moving → still).
# Lower = faster cycling, useful for quick effect testing.
MOCK_PERIOD=10.0

# Baseline sensor noise: the raw diff value you see in DEBUG=1 mode when
# the camera is completely covered and nothing is moving. Subtract this
# so that true stillness reads as 1.0. Typical range: 0.5–2.0.
# Used by the camera sensor only — the kinect sensor uses background
# subtraction and ignores NOISE_FLOOR / MOTION_THRESHOLD.
NOISE_FLOOR=1.0

# Mean pixel diff *above the noise floor* that counts as fully moving.
# Camera sensor only — kinect uses KINECT_MASK_CHANGE_THRESHOLD instead.
MOTION_THRESHOLD=5.0

# Signal model: "penalty" (event-triggered, recommended) or "ema" (legacy)
# penalty = motion fires a self-contained routine; image has its own gravity
# ema     = luminosity tracks the sensor continuously (old behaviour)
SIGNAL_MODE=penalty

# Raw sensor value below which motion is considered detected (0–1).
MOTION_TRIGGER=0.7

# --- PenaltyRoutine (used when SIGNAL_MODE=penalty) ---
# Near-black luminosity at the bottom of the penalty. 0.02 = ghost of image.
NADIR=0.12
# EMA time constant for the snap to nadir. 0.3s is nearly instant.
FALL_WINDOW=0.3
# Seconds frozen at nadir after last motion. Recovery cannot start until this elapses.
HOLD_DURATION=2.4
# Total seconds to climb from nadir back to full brightness.
RECOVERY_DURATION=8.0
# Power curve for recovery. > 1.0 = ease-in: lingers in darkness, fast near top.
# 2.5 spends ~70% of recovery time below half-brightness.
RECOVERY_CURVE=2.5

# --- PresenceSignal (used when SIGNAL_MODE=ema) ---
RISE_WINDOW=3.0

# --- Display ---
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
# Set to 1 to run fullscreen, 0 for windowed (dev mode)
FULLSCREEN=1

# --- Video ---
# Path to the video loop, relative to project root
VIDEO_PATH=assets/video/1min-slowFilm_10mbps_endymion-installation_h264.mp4

# Playback speed multiplier. 1.0 = normal speed. 0.5 = half speed (each frame
# held for 2 display ticks). 0.25 = quarter speed. No re-encoding needed.
# Preferred setting for the piece is 0.5.
VIDEO_SPEED=1.0

# --- Effects pipeline ---
# Comma-separated list of active effects, applied in order.
# Available: none, luminosity, vignette, ghosting, desaturation, blur
# Use EFFECTS=none for the baseline (full video, sensor ignored)
# Start with one, add more once each feels right.
EFFECTS=luminosity

# Luminosity curve applied on top of the signal value.
# 1.0 = linear (recommended when SIGNAL_MODE=penalty — PenaltyRoutine handles its own curve).
# < 1.0 = ease-out (useful with SIGNAL_MODE=ema to add midrange dwell).
LUM_CURVE=1.0

# When 1: run the effects pipeline at half resolution (960x540) and upscale
# to display size with INTER_LINEAR before blitting. Quarters the per-pixel
# work for every effect simultaneously. Required on the Pi to keep frame
# rate inside the 41.7ms budget at 24fps. Not needed on the Mac.
# See docs/SPEC-effects-performance.md §4 and docs/PERFORMANCE-effects.md §1.
HALF_RES_EFFECTS=0

# --- Logging ---
# Set to a file path to write per-frame sensor + effect data as CSV.
# Leave empty to disable. Use for calibration runs.
# Example: LOG_FILE=logs/session.csv
LOG_FILE=

# --- Debug ---
# Set to 1 to print raw/smoothed sensor values and state to the terminal
DEBUG=0
